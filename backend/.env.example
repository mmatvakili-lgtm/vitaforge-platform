# Copy to .env (never commit it). Real environment variables override this file.
DJANGO_SECRET_KEY=change-me-to-a-random-string-of-at-least-32-characters-xxxxxxxx
# Local development: true.  Production: false (then a real secret key and explicit ALLOWED_HOSTS are mandatory).
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# PostgreSQL (docker compose -f infra/docker-compose.yml up -d db) -- or sqlite:///db.sqlite3 for a zero-install trial
DATABASE_URL=postgres://vitaforge:vitaforge@localhost:5432/vitaforge
REDIS_URL=redis://localhost:6379/0
# LOCAL DEMO ONLY: loads EXPERIMENTAL sample exercises so plan generation works. Refused when DJANGO_DEBUG=false.
VITAFORGE_DEV_CONTENT=true
# Must stay false until privacy/legal review (OPEN-002); the server refuses to start if true.
AI_EXTERNAL_HEALTH_DATA=false
