# Dummy values only. Never commit real secrets.
DJANGO_SECRET_KEY=change-me-dummy
DJANGO_DEBUG=false
DATABASE_URL=postgres://vitaforge:vitaforge@localhost:5432/vitaforge
REDIS_URL=redis://localhost:6379/0
ALLOWED_HOSTS=localhost
AI_EXTERNAL_HEALTH_DATA=false
FEATURE_OFFLINE_WORKOUT_LOG=false

# --- Mail (account verification + password reset). Placeholders only: never commit real credentials.
FRONTEND_BASE_URL=http://localhost:3000
# Production REQUIRES smtp (startup fails otherwise). Local development: DJANGO_DEBUG=true + MAIL_PROVIDER=capture
# (messages are stored, NOT delivered; read them with `python manage.py show_captured_mail`).
MAIL_PROVIDER=smtp
MAIL_FROM_ADDRESS=noreply@example.invalid
MAIL_FROM_NAME=VitaForge
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT=10

# --- Telegram verification (primary channel). Placeholders only: never commit a real bot token.
# Create the bot with @BotFather. TELEGRAM_WEBHOOK_SECRET: 16-256 chars of A-Z a-z 0-9 _ - (e.g. `python -c "import secrets;print(secrets.token_urlsafe(32))"`).
# With a live bot, e-mail/SMTP becomes optional (MAIL_PROVIDER may be left unset). Local development without a bot: DJANGO_DEBUG=true + TELEGRAM_PROVIDER=capture.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_PROVIDER=live|capture|disabled   (default: live when token+username are set, else disabled)
